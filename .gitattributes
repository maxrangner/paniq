# Keep Unity's text-based assets reviewable in Git.
*.cs text diff=csharp
*.asmdef text
*.asset text
*.meta text
*.prefab text
*.unity text
*.json text
*.md text
*.py text
*.ps1 text

# Built models and pictures of them.
*.fbx binary
*.blend binary
*.png binary

